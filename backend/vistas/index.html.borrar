<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ccxi</title>
  <link rel="stylesheet" href="css/app.css" />
</head>
<body>
  <main class="contenedor">
    <header class="cabecera">
      <h1>CCxI - Calificador de Compentencias por Indicadores</h1>
      <p id="pEstado">Comprobando servidor...</p>
    </header>
    
	<!-- Vista de selección de módulo -->
    <div id="divModulos"> </div>
 
	<nav class="nav-principal" aria-label="Navegación principal">
	  <a href="#" class="nav-link active" data-view-target="alumnado">Alumnado</a>
	  <a href="#" class="nav-link" data-view-target="resultados-indicadores">Resultados/Indicadores</a>
	  <a href="#" class="nav-link" data-view-target="pruebas">Pruebas</a>
	  <a href="#" class="nav-link" data-view-target="calificaciones">Calificaciones</a>
	  <a href="#" class="nav-link" data-view-target="informes">Informes</a>
	</nav>

 	<section class="bloque" data-view="alumnado">
	</section>

	<section class="bloque" data-view="resultados-indicadores">
	  <h2>Resultados de Aprendizaje</h2>

	  <form id="form-resultado" class="formulario">
		<input type="hidden" id="resultado-id" />

		<label for="resultado-codigo">Código</label>
		<input type="text" id="resultado-codigo" maxlength="50" required="true" />

		<label for="resultado-nombre">Nombre</label>
		<input type="text" id="resultado-nombre" maxlength="150" required="true" />

		<label for="resultado-peso">Peso</label>
		<input type="text" id="resultado-peso" maxlength="150" required="true" />

		<div class="acciones-formulario">
		  <button type="submit">Guardar</button>
		  <button type="button" id="cancelar-edicion-resultado" hidden="true">Cancelar edición</button>
		</div>
	  </form>

	  <p id="mensaje-resultado" class="mensaje"> </p>

	  <table class="tabla">
		<thead>
		  <tr>
			<th>Código tron</th>
			<th>Nombre</th>
			<th>Acciones</th>
		  </tr>
		</thead>
		<tbody id="tabla-resultados"> </tbody>
	  </table>
	</section>

	<section class="bloque" data-view="resultados-indicadores">
	  <h2>Indicadores de Logro</h2>

	  <form id="form-indicador" class="formulario">
		<input type="hidden" id="indicador-id" />

		<label for="indicador-codigo">Código</label>
		<input type="text" id="indicador-codigo" maxlength="50" required="true" />

		<label for="indicador-nombre">Nombre</label>
		<input type="text" id="indicador-nombre" maxlength="150" required="true" />

		<div class="subbloque">
		  <h3>Asociar resultado</h3>

		  <div class="fila-asociacion">
			<select id="indicador-resultado-select"> </select>
			<input type="number" id="indicador-resultado-peso" min="1" step="1" placeholder="Peso" />
			<button type="button" id="anadir-resultado-indicador">Añadir</button>
		  </div>

		  <table class="tabla tabla-editor">
			<thead>
			  <tr>
				<th>Resultado</th>
				<th>Peso</th>
				<th>Acción</th>
			  </tr>
			</thead>
			<tbody id="tabla-indicador-resultados-editor"> </tbody>
		  </table>
		</div>

		<div class="acciones-formulario">
		  <button type="submit">Guardar</button>
		  <button type="button" id="cancelar-edicion-indicador" hidden="true">Cancelar edición</button>
		</div>
	  </form>

	  <p id="mensaje-indicador" class="mensaje"> </p>

	  <table class="tabla">
		<thead>
		  <tr>
			<th>ID</th>
			<th>Código</th>
			<th>Nombre</th>
			<th>Resultados asociados</th>
			<th>Acciones</th>
		  </tr>
		</thead>
		<tbody id="tabla-indicadores"> </tbody>
	  </table>
	</section>

	<section class="bloque" data-view="pruebas">
	</section>

	<section class="bloque" data-view="calificaciones">
	  <h2>Calificaciones</h2>

	  <div class="formulario">
		<label for="calificacion-prueba">Prueba</label>
		<select id="calificacion-prueba"> </select>

		<label for="calificacion-alumno">Alumno</label>
		<select id="calificacion-alumno"> </select>
	  </div>

	  <p id="mensaje-calificacion" class="mensaje"> </p>

	  <table class="tabla tabla-editor">
		<thead>
		  <tr>
			<th>Código</th>
			<th>Indicador</th>
			<th>Peso</th>
			<th>Nivel de logro</th>
			<th>Positivos/Negativos</th>
		  </tr>
		</thead>
		<tbody id="tabla-calificaciones"> </tbody>
	  </table>

	  <div class="acciones-formulario">
		<button type="button" id="guardar-calificacion">Guardar calificación</button>
		<button type="button" id="borrar-calificacion">Eliminar calificación</button>
	  </div>
	</section>

	<section class="bloque vista-oculta" data-view="informes">
	  <h2>Informes</h2>

	  <div class="formulario">
		<label for="tipo-informe">Tipo de informe</label>
		<select id="tipo-informe">
		  <option value="alumnado">Informe de Alumnado</option>
		  <option value="grupo">Informe de Grupo</option>
		</select>
	  </div>

	  <div id="panel-informe-alumnado">
		<div class="formulario">
		  <label for="informe-alumno">Alumno</label>
		  <select id="informe-alumno"> </select>

		  <label for="informe-fecha">Fecha del informe</label>
		  <input type="date" id="informe-fecha" />
		</div>

		<div class="acciones-formulario">
		  <button type="button" id="generar-informe-alumnado">Generar informe</button>
		  <button type="button" id="descargar-informe-pdf" disabled="true">Descargar PDF</button>
		</div>
	  </div>

		<div id="panel-informe-grupo" class="vista-oculta">
			<div class="formulario">
				<label for="informe-grupo-fecha">Fecha del informe</label>
				<input type="date" id="informe-grupo-fecha" />
			</div>

			<div class="acciones-formulario">
				<button type="button" id="generar-informe-grupo">Generar informe</button>
				<button type="button" id="descargar-informe-grupo-pdf" disabled="true">Descargar PDF</button>
			</div>
		</div>

	  <div id="salida-informe" class="salida-informe"> </div>
	</section>

  </main>

  <script type="module" src="js/api.js"> </script>
  <script type="module" src="js/app.js"> </script>
</body>
</html>
